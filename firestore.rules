rules_version = '2';

// ============================================================
// RUHRANK FIRESTORE SECURITY RULES
// ------------------------------------------------------------
// HOW TO USE (Hasnain):
//  1. Firebase console → Firestore Database → Rules tab
//  2. Delete everything there, paste this whole file, click Publish.
//  3. IMPORTANT: replace 6KegV2BsxTdYWH1OUHgR49p6CZC3 below with YOUR admin
//     user's UID (Firebase console → Authentication → Users → copy UID
//     of the admin email you created). Until you do that, NOBODY
//     (not even you) can write questions/tests — the app will still
//     READ fine, but admin writes will fail with "permission denied".
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helper: is the signed-in user the admin? ----
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "6KegV2BsxTdYWH1OUHgR49p6CZC3";
      // ^^^ Hasnain: replace 6KegV2BsxTdYWH1OUHgR49p6CZC3 with your admin UID ^^^
    }

    // ---- content collections: everyone reads, only admin writes ----
    match /questions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tests/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /competitions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notifications/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- users: each user reads/writes ONLY their own doc ----
    // (name/xp are mirrored into /leaderboard for the public board)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- leaderboard: public read; each user writes ONLY own entry ----
    // entry shape: { name, photo, xp, xpD, xpW, xpM, streak, exam, ts }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','photo','xp','xpD','xpW','xpM','streak','exam','ts'])
        && request.resource.data.xp is number;
      allow delete: if isAdmin();
    }

    // ---- live battle participants: public read; each user writes ONLY own entry ----
    // entry shape: { name, photo, joinedAt, score, answered, submitted, finalScore, correct, wrong, timeTaken, submittedAt }
    match /competitions/{compId}/participants/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- attempts (test results): user writes own, reads own ----
    match /attempts/{doc} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAdmin();
    }

    // ---- reports (user reports about wrong questions/issues) ----
    // create: signed-in user, only own reports; read: own or admin; update/delete: admin only
    match /reports/{doc} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAdmin();
    }

    // ---- bookmarks: private per user ----
    match /bookmarks/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // ---- everything else: locked ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
